---
import { formatGBP } from '../lib/taxRules.js';
const { result } = Astro.props;
---
<table class="table table-bordered bg-white">
  <tbody>
    <tr><th>Gross annual salary</th><td>{formatGBP(result.salary)}</td></tr>
    <tr><th>Personal Allowance</th><td>{formatGBP(result.personalAllowance)}</td></tr>
    <tr><th>Income Tax</th><td>{formatGBP(result.incomeTax)}</td></tr>
    <tr><th>National Insurance</th><td>{formatGBP(result.nationalInsurance)}</td></tr>
    <tr class="table-success"><th>Take-home (annual)</th><td><strong>{formatGBP(result.takeHomeAnnual)}</strong></td></tr>
    <tr><th>Take-home (monthly)</th><td>{formatGBP(result.takeHomeMonthly)}</td></tr>
    <tr><th>Take-home (weekly)</th><td>{formatGBP(result.takeHomeWeekly)}</td></tr>
    <tr><th>Effective tax rate</th><td>{result.effectiveRate}%</td></tr>
  </tbody>
</table>
<p class="text-muted small">Based on {result.taxYear} tax year rates. Estimates only — not financial advice.</p>
