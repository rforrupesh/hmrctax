---
import { withBase } from '../lib/url.js';
import { slugify, categoryOf } from '../lib/blog.js';

const { posts } = Astro.props;
---
<div class="row g-4 g-lg-4 mt-2" id="post-grid">
  {posts.map((p) => {
    const category = categoryOf(p);
    return (
      <div class="col-12 col-md-6 col-lg-4 post-grid-item" data-category={slugify(category)}>
        <a href={withBase(`tax-guides/${p.slug}/`)} class="blog-card h-100 d-flex flex-column text-decoration-none">
          {p.data.image && (
            <img src={p.data.image} alt={p.data.title} class="blog-card-thumb mb-3" loading="lazy" />
          )}
          <span class="blog-card-pill text-capitalize">{category.replace(/-/g, ' ')}</span>
          <h2 class="blog-card-title mb-2 mt-2">{p.data.title}</h2>
          <p class="blog-card-excerpt small mb-0">{p.data.description}</p>
        </a>
      </div>
    );
  })}
</div>
<p class="text-muted mt-4" id="post-grid-empty" style="display:none;">No guides in this category yet.</p>

<style>
  .blog-card{
    background: rgba(0,112,60,0.06);
    border-radius:10px !important;
    padding:1.5rem;
    color:inherit;
  }
  .blog-card:hover{ background: rgba(0,112,60,0.11); }
  .blog-card-thumb{
    aspect-ratio: 16/9;
    object-fit:cover;
    border-radius:8px !important;
    margin-left:-1.5rem;
    margin-top:-1.5rem;
    width:calc(100% + 3rem);
  }
  .blog-card-pill{
    display:inline-block;
    align-self:flex-start;
    background:var(--govblack);
    color:#fff;
    font-size:0.7rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.03em;
    padding:0.25rem 0.65rem;
    border-radius:999px !important;
  }
  .blog-card-title{
    font-weight:800;
    font-size:1.25rem;
    line-height:1.3;
    color:var(--govblack);
  }
  .blog-card-excerpt{
    color:#3d4449;
    line-height:1.45;
  }
</style>
