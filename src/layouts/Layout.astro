---
import { withBase } from '../lib/url.js';
import { SOCIAL_LINKS } from '../lib/social.js';
import 'bootstrap/dist/css/bootstrap.min.css';
const { title, description, ogImage, noindex } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalURL} />
<link rel="icon" href={withBase(`favicon.svg`)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
<meta name="twitter:card" content="summary_large_image" />
<style is:global>
  :root{
    --govgreen:#00703c;
    --govblue:#1d70b8;
    --govblack:#0b0c0c;
    --govyellow:#ffdd00;
    --govgrey:#f3f2f1;
    --govborder:#b1b4b6;
  }
  body{
    background:#fff;
    font-family: "GDS Transport", -apple-system, Arial, Helvetica, sans-serif;
    color:var(--govblack);
    font-size:1.0625rem;
    line-height:1.5;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *, *::before, *::after{ border-radius:0 !important; }
  a{ color:var(--govblue); }
  a:visited{ color:#4c2c92; }
  *:focus{
    outline:3px solid var(--govyellow) !important;
    outline-offset:0 !important;
    box-shadow:0 0 0 2px var(--govblack) !important;
  }
  .crown-bar{ background:var(--govblack); color:#fff; padding-top:calc(0.5rem + env(safe-area-inset-top,0px)); }
  main{ max-width:960px; }
  h1{ font-size:2.1rem; font-weight:700; letter-spacing:-0.02em; }
  .lead{ font-size:1.15rem; line-height:1.4; color:var(--govblack); }
  .form-control{ border:2px solid var(--govblack); font-size:1.1rem; padding:0.45rem 0.7rem; }
  .form-control:focus{ border-color:var(--govblack); box-shadow:none; }
  .input-group-text{ border:2px solid var(--govblack); border-right:none; background:var(--govgrey); font-size:1.1rem; }
  .form-check-input{ width:1.5rem; height:1.5rem; border:2px solid var(--govblack); margin-top:0; }
  .form-check-input:checked{ background-color:var(--govblack); border-color:var(--govblack); }
  .btn-freq{ border:2px solid var(--govblack); color:var(--govblack); background:#fff; font-size:1rem; }
  .btn-freq + .btn-freq{ border-left:none; }
  .btn-freq.active{ background:var(--govblack); border-color:var(--govblack); color:#fff; font-weight:700; }
  .btn-freq:hover:not(.active){ background:var(--govgrey); }
  .result-panel{ background:var(--govgreen); color:#fff; }
  .result-panel-label{ color:#fff; opacity:1; font-weight:600; letter-spacing:0.01em; }
  .result-panel .figure{ font-size:2.75rem; font-weight:700; line-height:1.05; }
  .swatch{ width:11px; height:11px; display:inline-block; }
  .bar{ border:1px solid var(--govblack); display:flex; height:22px; overflow:hidden; }
  .bar div{ height:100%; }
  .table thead th{ border-bottom:2px solid var(--govblack) !important; font-weight:700; font-size:0.85rem; }
  caption{ color:var(--govblack); font-weight:700; font-size:1rem; }
  details summary{ color:var(--govblue); font-weight:700; cursor:pointer; }
  footer{ color:#505a5f; }
  footer a{ color:var(--govblue); }
  .footer-wrap{ background:var(--govblack); padding:2.5rem 0; }
  .footer-wrap .container{ max-width:1320px; }
  @media (min-width:1400px){ .footer-wrap .container{ max-width:1520px; } }
  @media (max-width:576px){ .footer-wrap .container{ max-width:100%; padding-left:0.75rem; padding-right:0.75rem; } }
  .footer-card{
    background:#fff;
    border-radius:20px !important;
    overflow:hidden;
    position:relative;
    container-type:inline-size;
  }
  .footer-top{ padding:1.75rem 2rem 1.25rem; border-bottom:1px solid var(--govborder); }
  .footer-brand{ font-size:1.4rem; font-weight:700; color:var(--govblack); }
  .footer-brand .dot{ color:var(--govgreen); }
  .footer-links{ padding:2rem; }
  .footer-links h2{ font-size:0.95rem; letter-spacing:0.02em; }
  .footer-links ul a{ color:#505a5f; text-decoration:none; }
  .footer-links ul a:hover{ color:var(--govblack); text-decoration:underline; }
  .footer-social a{
    width:34px; height:34px; border-radius:50% !important;
    border:1px solid var(--govborder); display:inline-flex;
    align-items:center; justify-content:center; color:var(--govblack) !important;
    transition:border-color .15s ease;
  }
  .footer-social a:hover{ border-color:var(--govblack); }
  .footer-newsletter input{
    border:1px solid var(--govborder); border-radius:8px !important;
    padding:0.6rem 0.9rem; font-size:0.95rem; flex:1; min-width:0;
  }
  .footer-newsletter-btn{
    background:var(--govblack); color:#fff !important; border:none; border-radius:8px !important;
    padding:0.6rem 1.1rem; font-size:0.95rem; font-weight:600; white-space:nowrap;
    text-decoration:none !important;
  }
  .footer-newsletter-btn:hover{ background:#000; }
  .footer-bigtext{
    line-height:0.78; font-weight:800; letter-spacing:-0.03em;
    color:#15c760; user-select:none; overflow:hidden;
    white-space:nowrap; text-align:center;
    font-size:clamp(1.2rem,8cqi,19rem);
    padding:0 1rem;
    width:100%;
  }
  @media (max-width:576px){
    .footer-links{ padding:1.5rem; }
    .footer-top{ padding:1.5rem 1.5rem 1rem; }
  }
  .stat-box{ border:2px solid var(--govblack); padding:1rem; }
  .zero-note{ background:var(--govgrey); border-left:4px solid var(--govblue); padding:1rem 1.25rem; }
  @media (max-width:576px){
    h1{ font-size:1.6rem; }
    .lead{ font-size:1.05rem; }
    .result-panel .figure{ font-size:2.1rem; }
  }
</style>
</head>
<body>
<div class="crown-bar py-2">
  <div class="container d-flex align-items-center justify-content-between gap-2">
    <a href={withBase()} class="fw-bold text-decoration-none d-flex align-items-center gap-2" style="font-size:1.15rem; color:#fff;">
      <svg width="24" height="24" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="2" y="14" width="36" height="22" fill="none" stroke="#fff" stroke-width="2.2"/>
        <line x1="2" y1="14" x2="2" y2="36" stroke="#fff" stroke-width="2.2"/>
        <line x1="9.7" y1="14" x2="9.7" y2="36" stroke="#fff" stroke-width="2.2"/>
        <line x1="17.3" y1="14" x2="17.3" y2="36" stroke="#fff" stroke-width="2.2"/>
        <line x1="25" y1="14" x2="25" y2="36" stroke="#fff" stroke-width="2.2"/>
        <line x1="32.7" y1="14" x2="32.7" y2="36" stroke="#fff" stroke-width="2.2"/>
        <line x1="38" y1="14" x2="38" y2="36" stroke="#fff" stroke-width="2.2"/>
        <path d="M2 14L8 3h6l2 5 2-5h6l6 11" stroke="#fff" stroke-width="2.2" fill="none" stroke-linejoin="round"/>
      </svg>
      salary-calc<span style="color:var(--govyellow);">.co.uk</span>
    </a>
    <button type="button" class="nav-toggle d-md-none" id="navToggle" aria-expanded="false" aria-controls="navMenu" aria-label="Toggle menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</div>

<nav class="border-bottom bg-white site-nav">
  <div class="container">
    <ul class="nav" id="navMenu">
      <li class="nav-drawer-head d-md-none">
        <a href={withBase()} class="fw-bold text-decoration-none d-flex align-items-center gap-2" style="font-size:1.05rem; color:var(--govblack);">
          <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="2" y="14" width="36" height="22" fill="none" stroke="var(--govblack)" stroke-width="2.2"/>
            <line x1="2" y1="14" x2="2" y2="36" stroke="var(--govblack)" stroke-width="2.2"/>
            <line x1="9.7" y1="14" x2="9.7" y2="36" stroke="var(--govblack)" stroke-width="2.2"/>
            <line x1="17.3" y1="14" x2="17.3" y2="36" stroke="var(--govblack)" stroke-width="2.2"/>
            <line x1="25" y1="14" x2="25" y2="36" stroke="var(--govblack)" stroke-width="2.2"/>
            <line x1="32.7" y1="14" x2="32.7" y2="36" stroke="var(--govblack)" stroke-width="2.2"/>
            <line x1="38" y1="14" x2="38" y2="36" stroke="var(--govblack)" stroke-width="2.2"/>
            <path d="M2 14L8 3h6l2 5 2-5h6l6 11" stroke="var(--govblack)" stroke-width="2.2" fill="none" stroke-linejoin="round"/>
          </svg>
          salary-calc<span style="color:#00703c;">.co.uk</span>
        </a>
        <button type="button" class="nav-close" id="navClose" aria-label="Close menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--govblack)" stroke-width="2.4" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
        </button>
      </li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase()} style="color:var(--govblack);">Home</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`tax-calculator/`)} style="color:var(--govblack);">By Salary</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`tax-guides/`)} style="color:var(--govblack);">Guides</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`faq/`)} style="color:var(--govblack);">FAQ</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`about/`)} style="color:var(--govblack);">About</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`contact/`)} style="color:var(--govblack);">Contact</a></li>
    </ul>
  </div>
</nav>
<div class="nav-overlay d-md-none" id="navOverlay"></div>

<script>
  const navToggle = document.getElementById('navToggle');
  const navClose = document.getElementById('navClose');
  const navMenu = document.getElementById('navMenu');
  const navOverlay = document.getElementById('navOverlay');

  function openMenu() {
    navMenu?.classList.add('is-open');
    navOverlay?.classList.add('is-open');
    navToggle?.setAttribute('aria-expanded', 'true');
  }
  function closeMenu() {
    navMenu?.classList.remove('is-open');
    navOverlay?.classList.remove('is-open');
    navToggle?.setAttribute('aria-expanded', 'false');
  }

  navToggle?.addEventListener('click', () => {
    navMenu?.classList.contains('is-open') ? closeMenu() : openMenu();
  });
  navClose?.addEventListener('click', closeMenu);
  navOverlay?.addEventListener('click', closeMenu);
</script>

<style>
  .nav-toggle{
    background:none; border:2px solid #fff; border-radius:0 !important;
    width:36px; height:36px; display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .nav-overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(11,12,12,0.5);
    z-index:1040;
    opacity:0;
    transition:opacity 0.25s ease;
  }
  .nav-overlay.is-open{ display:block; opacity:1; }

  .nav-drawer-head{
    display:none;
    align-items:center;
    justify-content:space-between;
    padding:0.5rem 1rem 1rem;
    border-bottom:1px solid var(--govborder);
    margin-bottom:0.5rem;
  }
  .nav-close{
    background:none; border:2px solid var(--govblack); border-radius:0 !important;
    width:34px; height:34px; display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }

  @media (max-width: 767.98px){
    .site-nav{ display:block !important; border-bottom:none !important; }
    .site-nav .container{ padding:0 !important; max-width:none !important; }
    .site-nav #navMenu{
      position:fixed;
      top:0; left:0;
      height:100vh;
      width:75%;
      max-width:320px;
      background:#fff;
      flex-direction:column;
      flex-wrap:nowrap;
      z-index:1050;
      transform:translateX(-100%);
      transition:transform 0.25s ease;
      overflow-y:auto;
      padding-top:env(safe-area-inset-top,0px);
      box-shadow:2px 0 12px rgba(0,0,0,0.15);
    }
    .site-nav #navMenu.is-open{ display:flex; transform:translateX(0); }
    .nav-drawer-head{ display:flex; }
    #navMenu .nav-item{ padding:0 1rem; }
  }
  @media (min-width: 768px){
    .site-nav{ display:block; }
    .site-nav #navMenu{
      display:flex;
      flex-direction:row;
      width:auto;
    }
    .site-nav #navMenu .nav-item{ width:auto; }
    .site-nav #navMenu .nav-link{ border-top:none; }
  }
  #navMenu .nav-item{ width:100%; }
  #navMenu .nav-link{ padding-top:0.6rem; padding-bottom:0.6rem; border-top:1px solid var(--govborder); }
</style>

<slot />

<footer class="footer-wrap mt-4">
  <div class="container">
    <div class="footer-card">

      <div class="footer-top">
        <div class="footer-brand">Salary-Calc</div>
        <p class="small text-muted mb-0 mt-1">Free UK Income Tax, salary and take-home pay calculators with helpful tax guides. A standalone resource, not affiliated with HMRC or gov.uk — figures shown are estimates for guidance only.</p>
      </div>

      <div class="footer-links">
        <div class="row g-4">
          <div class="col-6 col-md-3">
            <h2 class="h6 fw-bold" style="color:var(--govblack);">Calculator</h2>
            <ul class="list-unstyled small">
              <li class="mb-2"><a href={withBase()}>Income Tax calculator</a></li>
              <li class="mb-2"><a href={withBase(`tax-calculator/`)}>Browse by salary</a></li>
            </ul>
          </div>
          <div class="col-6 col-md-3">
            <h2 class="h6 fw-bold" style="color:var(--govblack);">Tax Guides</h2>
            <ul class="list-unstyled small">
              <li class="mb-2"><a href={withBase(`tax-guides/`)}>All guides</a></li>
              <li class="mb-2"><a href={withBase(`faq/`)}>FAQ</a></li>
             <li class="mb-2"><a href={withBase(`methodology/`)}>Methodology</a></li>
            </ul>
          </div>
          <div class="col-6 col-md-3">
            <h2 class="h6 fw-bold" style="color:var(--govblack);">Site</h2>
            <ul class="list-unstyled small">
              <li class="mb-2"><a href={withBase(`about/`)}>About us</a></li>
              <li class="mb-2"><a href={withBase(`contact/`)}>Contact</a></li>
              <li class="mb-2"><a href={withBase(`privacy-policy/`)}>Privacy policy</a></li>
              <li class="mb-2"><a href={withBase(`terms/`)}>Terms &amp; conditions</a></li>
            </ul>
          </div>
          <div class="col-6 col-md-3">
            <h2 class="h6 fw-bold" style="color:var(--govblack);">Stay up to date</h2>
            <div class="footer-social d-flex gap-2 mb-3">
              {SOCIAL_LINKS.x && (
                <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer" aria-label="Follow us on X">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.6 8.7L23.4 22h-7.1l-5.6-6.9L4.3 22H1.1l8.1-9.3L0.9 2h7.3l5 6.3L18.9 2zm-1.2 18h1.9L7.4 4H5.4l12.3 16z"/></svg>
                </a>
              )}
              {SOCIAL_LINKS.youtube && (
                <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" aria-label="Subscribe on YouTube" style="color:#FF0000 !important;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5v-7l6.3 3.5-6.3 3.5Z"/></svg>
                </a>
              )}
              {SOCIAL_LINKS.pinterest && (
                <a href={SOCIAL_LINKS.pinterest} target="_blank" rel="noopener noreferrer" aria-label="Follow us on Pinterest" style="color:#E60023 !important;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pinterest" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.915 15.452c-.07-.633-.134-1.606.027-2.297.146-.625.938-3.977.938-3.977s-.239-.479-.239-1.187c0-1.113.645-1.943 1.448-1.943.682 0 1.012.512 1.012 1.127 0 .686-.437 1.712-.663 2.663-.188.796.4 1.446 1.185 1.446 1.422 0 2.515-1.5 2.515-3.664 0-1.915-1.377-3.254-3.342-3.254-2.276 0-3.612 1.707-3.612 3.471 0 .688.265 1.425.595 1.826a.24.24 0 0 1 .056.23c-.061.252-.196.796-.222.907-.035.146-.116.177-.268.107-1-.465-1.624-1.926-1.624-3.1 0-2.523 1.834-4.84 5.286-4.84 2.775 0 4.932 1.977 4.932 4.62 0 2.757-1.739 4.976-4.151 4.976-.811 0-1.573-.421-1.834-.919l-.498 1.902c-.181.695-.669 1.566-.995 2.097A8 8 0 1 0 8 0"/></svg>
                </a>
              )}
            </div>
            <p class="small fw-bold mb-2" style="color:var(--govblack);">Stay in touch</p>
            <a href={withBase(`contact/`)} class="footer-newsletter-btn d-inline-block">Contact us</a>
          </div>
        </div>
      </div>

      <div class="footer-bigtext" aria-hidden="true">SALARY-CALC.CO.UK</div>
    </div>

    <div class="small text-muted d-flex flex-wrap justify-content-between gap-2 pt-3" style="color:#9aa0a6 !important;">
      <span>&copy; {new Date().getFullYear()} salary-calc.co.uk</span>
      <span>Not an official HMRC or gov.uk service.</span>
    </div>
  </div>
</footer>
</body>
</html>
