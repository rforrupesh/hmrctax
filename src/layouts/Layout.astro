---
import { withBase } from '../lib/url.js';
import 'bootstrap/dist/css/bootstrap.min.css';
const { title, description, ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" href={withBase(`favicon.svg`)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
<meta name="twitter:card" content="summary_large_image" />
<style is:global>
  :root{
    --govgreen:#00703c;
    --govblue:#1d70b8;
    --govblack:#0b0c0c;
    --govyellow:#ffdd00;
    --govgrey:#f3f2f1;
    --govborder:#b1b4b6;
  }
  body{
    background:#fff;
    font-family: "GDS Transport", -apple-system, Arial, Helvetica, sans-serif;
    color:var(--govblack);
    font-size:1.0625rem;
    line-height:1.5;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *, *::before, *::after{ border-radius:0 !important; }
  a{ color:var(--govblue); }
  a:visited{ color:#4c2c92; }
  *:focus{
    outline:3px solid var(--govyellow) !important;
    outline-offset:0 !important;
    box-shadow:0 0 0 2px var(--govblack) !important;
  }
  .crown-bar{ background:var(--govblack); color:#fff; padding-top:calc(0.5rem + env(safe-area-inset-top,0px)); }
  main{ max-width:960px; }
  h1{ font-size:2.1rem; font-weight:700; letter-spacing:-0.02em; }
  .lead{ font-size:1.15rem; line-height:1.4; color:var(--govblack); }
  .form-control{ border:2px solid var(--govblack); font-size:1.1rem; padding:0.45rem 0.7rem; }
  .form-control:focus{ border-color:var(--govblack); box-shadow:none; }
  .input-group-text{ border:2px solid var(--govblack); border-right:none; background:var(--govgrey); font-size:1.1rem; }
  .form-check-input{ width:1.5rem; height:1.5rem; border:2px solid var(--govblack); margin-top:0; }
  .form-check-input:checked{ background-color:var(--govblack); border-color:var(--govblack); }
  .btn-freq{ border:2px solid var(--govblack); color:var(--govblack); background:#fff; font-size:1rem; }
  .btn-freq + .btn-freq{ border-left:none; }
  .btn-freq.active{ background:var(--govblack); border-color:var(--govblack); color:#fff; font-weight:700; }
  .btn-freq:hover:not(.active){ background:var(--govgrey); }
  .result-panel{ background:var(--govgreen); color:#fff; }
  .result-panel-label{ color:#fff; opacity:1; font-weight:600; letter-spacing:0.01em; }
  .result-panel .figure{ font-size:2.75rem; font-weight:700; line-height:1.05; }
  .swatch{ width:11px; height:11px; display:inline-block; }
  .bar{ border:1px solid var(--govblack); display:flex; height:22px; overflow:hidden; }
  .bar div{ height:100%; }
  .table thead th{ border-bottom:2px solid var(--govblack) !important; font-weight:700; font-size:0.85rem; }
  caption{ color:var(--govblack); font-weight:700; font-size:1rem; }
  details summary{ color:var(--govblue); font-weight:700; cursor:pointer; }
  footer{ border-top:1px solid var(--govborder); color:#505a5f; background:var(--govgrey); }
  footer a{ color:var(--govblue); }
  .stat-box{ border:2px solid var(--govblack); padding:1rem; }
  .zero-note{ background:var(--govgrey); border-left:4px solid var(--govblue); padding:1rem 1.25rem; }
  @media (max-width:576px){
    h1{ font-size:1.6rem; }
    .lead{ font-size:1.05rem; }
    .result-panel .figure{ font-size:2.1rem; }
  }
</style>
</head>
<body>
<div class="crown-bar py-2">
  <div class="container d-flex align-items-center gap-2">
    <svg width="24" height="24" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="2" y="14" width="36" height="22" fill="none" stroke="#fff" stroke-width="2.2"/>
      <line x1="2" y1="14" x2="2" y2="36" stroke="#fff" stroke-width="2.2"/>
      <line x1="9.7" y1="14" x2="9.7" y2="36" stroke="#fff" stroke-width="2.2"/>
      <line x1="17.3" y1="14" x2="17.3" y2="36" stroke="#fff" stroke-width="2.2"/>
      <line x1="25" y1="14" x2="25" y2="36" stroke="#fff" stroke-width="2.2"/>
      <line x1="32.7" y1="14" x2="32.7" y2="36" stroke="#fff" stroke-width="2.2"/>
      <line x1="38" y1="14" x2="38" y2="36" stroke="#fff" stroke-width="2.2"/>
      <path d="M2 14L8 3h6l2 5 2-5h6l6 11" stroke="#fff" stroke-width="2.2" fill="none" stroke-linejoin="round"/>
    </svg>
    <a href={withBase()} class="fw-bold text-decoration-none" style="font-size:1.15rem; color:#fff;">salary-calc<span style="color:var(--govyellow);">.co.uk</span></a>
  </div>
</div>

<nav class="border-bottom bg-white">
  <div class="container">
    <ul class="nav" style="overflow-x:auto; flex-wrap:nowrap; white-space:nowrap;">
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase()} style="color:var(--govblack);">Home</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`tax-calculator/`)} style="color:var(--govblack);">By Salary</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`tax-guides/`)} style="color:var(--govblack);">Guides</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`faq/`)} style="color:var(--govblack);">FAQ</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`about/`)} style="color:var(--govblack);">About</a></li>
      <li class="nav-item"><a class="nav-link fw-bold px-2 px-md-3" href={withBase(`contact/`)} style="color:var(--govblack);">Contact</a></li>
    </ul>
  </div>
</nav>

<slot />

<footer class="py-5 mt-4">
  <div class="container">
    <div class="row g-4">
      <div class="col-6 col-md-3">
        <h2 class="h6 fw-bold" style="color:var(--govblack);">Calculator</h2>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href={withBase()}>Income Tax calculator</a></li>
          <li class="mb-2"><a href={withBase(`tax-calculator/`)}>Browse by salary</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-3">
        <h2 class="h6 fw-bold" style="color:var(--govblack);">Tax Guides</h2>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href={withBase(`tax-guides/`)}>All guides</a></li>
          <li class="mb-2"><a href={withBase(`faq/`)}>FAQ</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-3">
        <h2 class="h6 fw-bold" style="color:var(--govblack);">Site</h2>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href={withBase(`about/`)}>About us</a></li>
          <li class="mb-2"><a href={withBase(`contact/`)}>Contact</a></li>
          <li class="mb-2"><a href={withBase(`privacy-policy/`)}>Privacy policy</a></li>
          <li class="mb-2"><a href={withBase(`terms/`)}>Terms &amp; conditions</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-3">
        <h2 class="h6 fw-bold" style="color:var(--govblack);">salary-calc.co.uk</h2>
        <p class="small text-muted">Independent Income Tax tools and guidance for the UK. Not affiliated with HM Revenue &amp; Customs or gov.uk.</p>
        <p class="small fw-bold mb-2" style="color:var(--govblack);">Follow us</p>
        <ul class="list-inline">
          <li class="list-inline-item me-3">
            <a href="https://x.com/YOUR_HANDLE" target="_blank" rel="noopener noreferrer" aria-label="Follow us on X" style="color:var(--govblack);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.6 8.7L23.4 22h-7.1l-5.6-6.9L4.3 22H1.1l8.1-9.3L0.9 2h7.3l5 6.3L18.9 2zm-1.2 18h1.9L7.4 4H5.4l12.3 16z"/></svg>
            </a>
          </li>
          <li class="list-inline-item me-3">
            <a href="https://youtube.com/@YOUR_CHANNEL" target="_blank" rel="noopener noreferrer" aria-label="Subscribe on YouTube" style="color:var(--govblack);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5v-7l6.3 3.5-6.3 3.5Z"/></svg>
            </a>
          </li>
          <li class="list-inline-item">
            <a href="https://pinterest.com/YOUR_PROFILE" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Pinterest" style="color:var(--govblack);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0a12 12 0 0 0-4.4 23.2c-.06-.9-.1-2.3.02-3.3.11-.9.75-5.8.75-5.8s-.19-.38-.19-.94c0-.88.51-1.54 1.15-1.54.54 0 .8.4.8.89 0 .54-.35 1.36-.53 2.11-.15.63.32 1.15.94 1.15 1.13 0 2-1.19 2-2.9 0-1.52-1.09-2.58-2.65-2.58-1.8 0-2.86 1.35-2.86 2.75 0 .54.21 1.12.47 1.44a.19.19 0 0 1 .04.18c-.05.2-.16.63-.18.72-.03.12-.1.15-.22.09-.85-.4-1.38-1.63-1.38-2.63 0-2.14 1.56-4.11 4.48-4.11 2.35 0 4.18 1.68 4.18 3.92 0 2.34-1.47 4.22-3.52 4.22-.69 0-1.33-.36-1.55-.78l-.42 1.6c-.15.59-.56 1.32-.84 1.77A12 12 0 1 0 12 0Z"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-top py-3 mt-4">
    <div class="container small text-muted d-flex flex-wrap justify-content-between gap-2">
      <span>&copy; {new Date().getFullYear()} salary-calc.co.uk</span>
      <span>Not an official HMRC or gov.uk service.</span>
    </div>
  </div>
</footer>
</body>
</html>
