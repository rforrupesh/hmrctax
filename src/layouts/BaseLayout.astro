---
const { title, description = 'Free UK salary tax calculator — Income Tax and National Insurance breakdown.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root { --govblue: #1d70b8; --govblack: #0b0c0c; --govyellow: #ffdd00; }
    body { font-family: 'Helvetica Neue', Arial, sans-serif; color: var(--govblack); }
    .navbar-gov { background: var(--govblack); }
    .navbar-gov .navbar-brand { color: #fff; font-weight: 700; }
    .navbar-gov .nav-link { color: #fff !important; }
    .navbar-gov .navbar-brand span { color: var(--govyellow); }
    a { color: var(--govblue); }
    .footer-gov { background: #f3f2f1; border-top: 4px solid var(--govblue); margin-top: 4rem; padding: 2.5rem 0; }
    .badge-not-official { background: #d4351c; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-gov py-3">
    <div class="container">
      <a class="navbar-brand" href="/">Tax<span>Calc</span> UK</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto gap-2">
          <li class="nav-item"><a class="nav-link" href="/">Calculator</a></li>
          <li class="nav-item"><a class="nav-link" href="/about/">About</a></li>
          <li class="nav-item"><a class="nav-link" href="/contact/">Contact</a></li>
          <li class="nav-item"><a class="nav-link" href="/disclaimer/">Disclaimer</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <slot />
  </main>

  <footer class="footer-gov">
    <div class="container">
      <span class="badge badge-not-official text-white mb-3 d-inline-block">Not affiliated with HMRC or GOV.UK</span>
      <div class="row">
        <div class="col-md-6">
          <p class="mb-1"><strong>TaxCalc UK</strong> — free, independent salary tax calculator.</p>
          <p class="text-muted small">Figures are estimates for guidance only and are not financial advice.</p>
        </div>
        <div class="col-md-6 text-md-end">
          <a href="/about/" class="me-3">About</a>
          <a href="/contact/" class="me-3">Contact</a>
          <a href="/privacy-policy/" class="me-3">Privacy Policy</a>
          <a href="/terms/" class="me-3">Terms</a>
          <a href="/disclaimer/">Disclaimer</a>
        </div>
      </div>
      <hr>
      <p class="text-muted small mb-0">&copy; {new Date().getFullYear()} TaxCalc UK. All rights reserved.</p>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
