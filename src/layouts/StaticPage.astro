---
// Shared layout for static informational pages (About, Contact, Terms,
// Privacy Policy, Methodology, etc), driven by src/content/pages/*.md —
// same idea as BlogPost.astro for blog posts. No "Updated on" date, no
// related-posts, no author/tags footer, since those are blog-only concepts.
import Layout from './Layout.astro';
import { withBase } from '../lib/url.js';

interface Heading { depth: number; slug: string; text: string }

interface Props {
  title: string;
  description: string;
  heroLead?: string;
  image?: string;
  takeaways?: string[];
  headings?: Heading[];
}

const { title, description, heroLead, image, takeaways = [], headings = [] } = Astro.props;
// Only top-level (##) headings go in the TOC, same rule as blog posts.
const toc = headings.filter((h) => h.depth === 2);

const imageUrl = image
  ? (/^https?:\/\//i.test(image) ? image : withBase(image))
  : null;
---
<Layout title={`${title} | salary-calc.co.uk`} description={description}>
  <div class={`post-hero${imageUrl ? ' has-thumb' : ''}`}>
    <div class="container py-4 h-100 post-hero-inner">
      <p class="post-hero-breadcrumb small mb-3">
        <a href={withBase()}>Home</a> / {title}
      </p>
      <h1 class="post-hero-title mt-2">{title}</h1>
      {heroLead && <p class="post-hero-lead mb-0">{heroLead}</p>}
    </div>

    {imageUrl && (
      <div class="post-hero-thumb-wrap">
        <img src={imageUrl} alt={title} class="post-hero-thumb" loading="eager" />
      </div>
    )}
  </div>

  <main class="container py-5" style="max-width:1200px;">
    <div class="row g-4">
      {toc.length > 0 && (
        <div class="col-12 col-lg-3 order-2 order-lg-1">
          <nav class="post-sidebar-box post-toc-box mb-4" aria-label="Table of contents">
            <h2 class="post-sidebar-label mb-3">Table of Contents</h2>
            <ol class="ps-3 small mb-0 post-toc">
              {toc.map((h) => (
                <li class="mb-2"><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        </div>
      )}

      <div class={`col-12 order-1 order-lg-2 ${toc.length > 0 ? 'col-lg-9' : ''}`} style={toc.length === 0 ? 'max-width:900px;' : ''}>
        {takeaways.length > 0 && (
          <div class="key-takeaways-box mb-4">
            <h2 class="key-takeaways-title mb-3">Key Takeaways</h2>
            <ul class="mb-0">
              {takeaways.map((t) => (
                <li class="mb-2">{t}</li>
              ))}
            </ul>
          </div>
        )}

        <article class="blog-article">
          <slot />
        </article>
      </div>
    </div>
  </main>
</Layout>

<style>
  .post-hero{
    position: relative;
    background: linear-gradient(135deg, var(--govblue), #123a5c);
    overflow: hidden;
  }
  .post-hero-inner{ position: relative; z-index: 2; max-width: 900px; }
  .post-hero-inner.has-thumb{ padding-right: 44%; }
  .post-hero-breadcrumb a{ color:rgba(255,255,255,0.75); text-decoration:none; }
  .post-hero-breadcrumb a:hover{ color:#fff; text-decoration:underline; }
  .post-hero-title{ color:#fff; font-size:2.2rem; margin-bottom:0.5rem; }
  .post-hero-lead{ color:rgba(255,255,255,0.85); font-size:1.05rem; max-width:65ch; }
  .post-hero-thumb-wrap{
    position: absolute;
    top: 0; right: 0; bottom: 0;
    height: 100%;
    width: 42%;
    z-index: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14%);
    mask-image: linear-gradient(to right, transparent 0, #000 14%);
  }
  .post-hero-thumb{ width:100%; height:100%; object-fit:cover; display:block; }

  .blog-article :global(h2) { font-size: 1.3rem; font-weight: 700; margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-article :global(h3) { font-size: 1.1rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .blog-article :global(p) { margin-bottom: 1rem; max-width: 70ch; }
  .blog-article :global(ul), .blog-article :global(ol) { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-article :global(li) { margin-bottom: 0.35rem; }
  .blog-article :global(a) { color: var(--govblue); text-decoration: underline; }
  .blog-article :global(strong) { font-weight: 700; }
  .blog-article :global(img) { max-width: 100%; height: auto; }

  .blog-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .blog-article :global(th),
  .blog-article :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--govborder);
    text-align: left;
  }
  .blog-article :global(thead th) {
    border-bottom: 2px solid var(--govblack);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .blog-article :global(tbody tr:nth-child(even)) { background: var(--govgrey); }

  .key-takeaways-box{
    background: rgba(29,112,184,0.07);
    border-radius:10px !important;
    padding:1.5rem 1.75rem;
  }
  .key-takeaways-title{ color:var(--govblue); font-size:1.1rem; font-weight:700; }

  .post-sidebar-box{
    background: rgba(0,112,60,0.05);
    border-radius:10px !important;
    padding:1.25rem 1.4rem;
  }
  .post-sidebar-label{
    font-size:0.72rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.05em;
    color:#505a5f;
    margin:0;
  }
  .post-toc li a{ color:var(--govblack); text-decoration:none; line-height:1.4; }
  .post-toc li a:hover{ color:var(--govblue); text-decoration:underline; }

  @media (min-width: 992px){
    .post-toc-box{ position:sticky; top:1rem; }
  }

  @media (max-width: 991.98px){
    .post-hero{ height:auto; overflow:visible; }
    .post-hero-inner.has-thumb{ padding-right: 0; padding-bottom: 1rem; }
    .post-hero-thumb-wrap{
      position: static;
      width: 100%;
      height: 220px;
      margin-top: 1.5rem;
      border-radius: 10px !important;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
