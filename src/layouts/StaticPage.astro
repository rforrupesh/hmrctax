---
// Shared layout for static informational pages (About, Contact, Terms,
// Privacy Policy, Methodology, etc), driven by src/content/pages/*.md —
// same idea as BlogPost.astro for blog posts. No "Updated on" date, no
// related-posts, no author/tags footer, since those are blog-only concepts.
import Layout from './Layout.astro';
import { withBase } from '../lib/url.js';

interface Heading { depth: number; slug: string; text: string }

interface Props {
  title: string;
  description: string;
  heroLead?: string;
  image?: string;
  takeaways?: string[];
  headings?: Heading[];
}

const { title, description, heroLead, image, takeaways = [], headings = [] } = Astro.props;
// Only top-level (##) headings go in the TOC, same rule as blog posts.
const toc = headings.filter((h) => h.depth === 2);

const imageUrl = image
  ? (/^https?:\/\//i.test(image) ? image : withBase(image))
  : null;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---
<Layout title={`${title} | salary-calc.co.uk`} description={description}>
  <div class={`post-hero${imageUrl ? ' has-thumb' : ''}`}>
    <div class="container py-4 h-100 post-hero-inner">
      <p class="post-hero-breadcrumb small mb-3">
        <a href={withBase()}>Home</a> / {title}
      </p>
      <h1 class="post-hero-title mt-2">{title}</h1>
      {heroLead && <p class="post-hero-lead mb-0">{heroLead}</p>}
    </div>

    {imageUrl && (
      <div class="post-hero-thumb-wrap">
        <img src={imageUrl} alt={title} class="post-hero-thumb" loading="eager" />
      </div>
    )}
  </div>

  <main class="container py-5" style="max-width:1200px;">
    <div class="row g-4">
      <div class="col-12 col-lg-3 order-2 order-lg-1">
        {toc.length > 0 && (
          <nav class="post-sidebar-box post-toc-box mb-4" aria-label="Table of contents">
            <h2 class="post-sidebar-label mb-3">Table of Contents</h2>
            <ol class="ps-3 small mb-0 post-toc">
              {toc.map((h) => (
                <li class="mb-2"><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </div>

      <div class="col-12 col-lg-6 order-1 order-lg-2">
        {takeaways.length > 0 && (
          <div class="key-takeaways-box mb-4">
            <h2 class="key-takeaways-title mb-3">Key Takeaways</h2>
            <ul class="mb-0">
              {takeaways.map((t) => (
                <li class="mb-2">{t}</li>
              ))}
            </ul>
          </div>
        )}

        <article class="blog-article">
          <slot />
        </article>
      </div>

      <div class="col-12 col-lg-3 order-3">
        <div class="post-sidebar-box mb-4">
          <h2 class="post-sidebar-label mb-3">Share this Post</h2>
          <div class="d-flex flex-row align-items-center gap-2 share-icons">
            <a
              class="share-icon-btn"
              target="_blank"
              rel="noopener"
              aria-label="Share on X / Twitter"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="#000000" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z"/></svg>
            </a>
            <a
              class="share-icon-btn"
              target="_blank"
              rel="noopener"
              aria-label="Share on LinkedIn"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="#0A66C2" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.048c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.559V9h3.555z"/></svg>
            </a>
            <button type="button" class="share-icon-btn" id="copyLinkBtn" data-url={pageUrl} aria-label="Copy link">
              <svg class="copy-icon-default" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--govblack)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-2.83 2.83a5 5 0 0 0 7.07 7.07l1.5-1.5"/></svg>
              <svg class="copy-icon-done" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#1a7f37" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const btn = document.getElementById('copyLinkBtn');
  const defaultIcon = btn?.querySelector('.copy-icon-default');
  const doneIcon = btn?.querySelector('.copy-icon-done');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url') || '';
    try {
      await navigator.clipboard.writeText(url);
      btn.classList.add('copied');
      if (defaultIcon) (defaultIcon as HTMLElement).style.display = 'none';
      if (doneIcon) (doneIcon as HTMLElement).style.display = 'block';
      setTimeout(() => {
        btn.classList.remove('copied');
        if (defaultIcon) (defaultIcon as HTMLElement).style.display = 'block';
        if (doneIcon) (doneIcon as HTMLElement).style.display = 'none';
      }, 1500);
    } catch {
      // clipboard API unavailable — silently ignore
    }
  });
</script>

<style>
  .share-icon-btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #fff;
    border: 2px solid var(--govblack);
    flex-shrink: 0;
    transition: background 0.15s ease;
  }
  .share-icon-btn:hover{
    background: var(--govgrey);
  }
  .share-icon-btn.copied{
    background: #eaf7ec;
    border-color: #1a7f37;
  }
  .post-hero{
    position: relative;
    background: linear-gradient(135deg, var(--govblue), #123a5c);
    overflow: hidden;
  }
  .post-hero-inner{ position: relative; z-index: 2; max-width: 900px; margin-left: 0 !important; padding-left: clamp(1rem, 5vw, 3rem) !important; }
  .post-hero-inner.has-thumb{ padding-right: 44%; }
  .post-hero-breadcrumb a{ color:rgba(255,255,255,0.75); text-decoration:none; }
  .post-hero-breadcrumb a:hover{ color:#fff; text-decoration:underline; }
  .post-hero-title{ color:#fff; font-size:2.2rem; margin-bottom:0.5rem; }
  .post-hero-lead{ color:rgba(255,255,255,0.85); font-size:1.05rem; max-width:65ch; }
  .post-hero-thumb-wrap{
    position: absolute;
    top: 0; right: 0; bottom: 0;
    height: 100%;
    width: 42%;
    z-index: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14%);
    mask-image: linear-gradient(to right, transparent 0, #000 14%);
  }
  .post-hero-thumb{ width:100%; height:100%; object-fit:cover; display:block; }

  .blog-article :global(h2) { font-size: 1.3rem; font-weight: 700; margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-article :global(h3) { font-size: 1.1rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .blog-article :global(p) { margin-bottom: 1rem; max-width: 70ch; }
  .blog-article :global(ul), .blog-article :global(ol) { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-article :global(li) { margin-bottom: 0.35rem; }
  .blog-article :global(a) { color: var(--govblue); text-decoration: underline; }
  .blog-article :global(strong) { font-weight: 700; }
  .blog-article :global(img) { max-width: 100%; height: auto; }

  .blog-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .blog-article :global(th),
  .blog-article :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--govborder);
    text-align: left;
  }
  .blog-article :global(thead th) {
    border-bottom: 2px solid var(--govblack);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .blog-article :global(tbody tr:nth-child(even)) { background: var(--govgrey); }

  .key-takeaways-box{
    background: rgba(29,112,184,0.07);
    border-radius:10px !important;
    padding:1.5rem 1.75rem;
  }
  .key-takeaways-title{ color:var(--govblue); font-size:1.1rem; font-weight:700; }

  .post-sidebar-box{
    background: rgba(0,112,60,0.05);
    border-radius:10px !important;
    padding:1.25rem 1.4rem;
  }
  .post-sidebar-label{
    font-size:0.72rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.05em;
    color:#505a5f;
    margin:0;
  }
  .post-toc li a{ color:var(--govblack); text-decoration:none; line-height:1.4; }
  .post-toc li a:hover{ color:var(--govblue); text-decoration:underline; }

  @media (min-width: 992px){
    .post-toc-box{ position:sticky; top:1rem; }
  }

  @media (max-width: 991.98px){
    .post-hero{ height:auto; overflow:visible; }
    .post-hero-inner.has-thumb{ padding-right: 0; padding-bottom: 1rem; }
    .post-hero-thumb-wrap{
      position: static;
      width: 100%;
      height: 220px;
      margin-top: 1.5rem;
      border-radius: 10px !important;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
