---
// Shared layout for every blog post. Handles the hero banner, table of
// contents, key takeaways, related-post suggestions, and share buttons —
// so a new post only needs a markdown file in src/content/blog/, nothing
// else.
import Layout from './Layout.astro';
import PostGrid from '../components/PostGrid.astro';
import { withBase } from '../lib/url.js';
import { slugify, categoryOf, authorOf, formatDate as fmtDate } from '../lib/blog.js';
import { getDominantColor, heroGradientFrom } from '../lib/dominantColor.js';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, publishDate, updatedDate, tags, takeaways } = post.data;
const category = categoryOf(post);
const author = authorOf(post);

const allPosts = await getCollection('blog');

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const others = allPosts.filter((p) => p.slug !== post.slug);
const differentCategory = shuffle(others.filter((p) => categoryOf(p) !== category));
const sameCategory = shuffle(others.filter((p) => categoryOf(p) === category));
// Prefer posts from a different category so "related" doesn't just mean
// "same tag" — falls back to same-category posts if there aren't enough.
const related = [...differentCategory, ...sameCategory].slice(0, 3);

// Only top-level (##) headings go in the TOC to keep it short and scannable.
const toc = headings.filter((h) => h.depth === 2);

const pageUrl = new URL(withBase(`tax-guides/${post.slug}/`), Astro.site).toString();

const dateFmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';

const dominantColor = post.data.image ? await getDominantColor(post.data.image) : null;
const heroGradient = heroGradientFrom(dominantColor);
---
<Layout title={`${title} | hmrctax.co.uk`} description={description}>
  <div class="post-hero" style={heroGradient ? `background: ${heroGradient};` : ''}>
    <div class={`container py-4 h-100 post-hero-inner${post.data.image ? ' has-thumb' : ''}`}>
      <p class="post-hero-breadcrumb small mb-3">
        <a href={withBase()}>Home</a> / <a href={withBase(`tax-guides/`)}>Tax Guides</a>
      </p>

      <h1 class="post-hero-title mt-2">{title}</h1>
      <p class="post-hero-lead mb-4">{description}</p>

      <div class="d-flex align-items-center gap-2">
        <span class="post-hero-byline small">
          {updatedDate ? <>Updated on {dateFmt(updatedDate)}</> : <>Published: {dateFmt(publishDate)}</>}
        </span>
      </div>
    </div>

    {post.data.image && (
      <div class="post-hero-thumb-wrap">
        <img src={post.data.image} alt={title} class="post-hero-thumb" loading="eager" />
      </div>
    )}
  </div>

  <main class="container py-5" style="max-width:1200px;">
    <div class="row g-4">
      <div class="col-12 col-lg-3 order-2 order-lg-1">
        {toc.length > 0 && (
          <nav class="post-sidebar-box post-toc-box mb-4" aria-label="Table of contents">
            <h2 class="post-sidebar-label mb-3">Table of Contents</h2>
            <ol class="ps-3 small mb-0 post-toc">
              {toc.map((h) => (
                <li class="mb-2"><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </div>

      <div class="col-12 col-lg-6 order-1 order-lg-2">
        {takeaways.length > 0 && (
          <div class="key-takeaways-box mb-4">
            <h2 class="key-takeaways-title mb-3">Key Takeaways</h2>
            <ul class="mb-0">
              {takeaways.map((t) => (
                <li class="mb-2">{t}</li>
              ))}
            </ul>
          </div>
        )}

        <article class="blog-article">
          <slot />
        </article>

        <footer class="post-footer mt-5 pt-4">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="post-footer-label">Written by:</span>
            <a href={withBase(`author/${slugify(author)}/`)} class="d-flex align-items-center gap-2 text-decoration-none">
              <span class="author-avatar-sm">{author.trim().charAt(0).toUpperCase()}</span>
              <span class="small fw-semibold" style="color:var(--govblack);">{author}</span>
            </a>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="post-footer-label">Category:</span>
            <a href={withBase(`tax-guides/category/${slugify(category)}/`)} class="tag-pill category-pill-link text-capitalize text-decoration-none">{category.replace(/-/g, ' ')}</a>
          </div>
          {tags.length > 0 && (
            <div class="d-flex flex-wrap align-items-center gap-2">
              <span class="post-footer-label">Tags:</span>
              {tags.map((t) => (
                <a href={withBase(`tax-guides/tag/${slugify(t)}/`)} class="tag-pill text-capitalize text-decoration-none">{t.replace(/-/g, ' ')}</a>
              ))}
            </div>
          )}
        </footer>
      </div>

      <div class="col-12 col-lg-3 order-3">
        <div class="post-sidebar-box mb-4">
          <h2 class="post-sidebar-label mb-3">Share this Post</h2>
          <div class="d-flex flex-column gap-2">
            <a
              class="btn btn-sm btn-freq text-start"
              target="_blank"
              rel="noopener"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`}
            >X / Twitter</a>
            <a
              class="btn btn-sm btn-freq text-start"
              target="_blank"
              rel="noopener"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`}
            >LinkedIn</a>
            <button type="button" class="btn btn-sm btn-freq text-start" id="copyLinkBtn" data-url={pageUrl}>Copy link</button>
          </div>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="related-posts mt-5 pt-4 border-top">
        <h2 class="h5 fw-bold mb-4">You might also like</h2>
        <PostGrid posts={related} />
      </section>
    )}
  </main>
</Layout>

<style>
  .post-hero{
    position: relative;
    background: linear-gradient(135deg, var(--govblack), var(--govblue));
    color:#fff;
    height: 280px;
    overflow: hidden;
  }
  .post-hero-inner{
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 2;
  }
  .post-hero-inner.has-thumb{
    padding-right: 44%;
  }
  .post-hero-breadcrumb a{ color:rgba(255,255,255,0.75); text-decoration:none; }
  .post-hero-breadcrumb a:hover{ color:#fff; text-decoration:underline; }
  .post-hero-title{ color:#fff; font-size:2.2rem; margin-bottom:0.5rem; }
  .post-hero-lead{ color:rgba(255,255,255,0.85); font-size:1.05rem; max-width:65ch; }
  .post-hero-byline{ color:rgba(255,255,255,0.85); line-height:1.5; }
  .post-hero-byline a{ color:#fff; text-decoration:underline; }
  .post-hero-thumb-wrap{
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    width: 42%;
    z-index: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14%);
    mask-image: linear-gradient(to right, transparent 0, #000 14%);
  }
  .post-hero-thumb{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.05);
  }
  .post-hero-thumb-wrap::after{
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0) 30%, rgba(0,0,0,0) 65%, rgba(0,0,0,0.25));
    pointer-events: none;
  }
  .author-avatar-hero{
    width:40px; height:40px; flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
    background:#fff; color:var(--govblack);
    border-radius:50% !important;
    font-size:0.95rem; font-weight:700;
  }

  .key-takeaways-box{
    background: rgba(29,112,184,0.07);
    border-radius:10px !important;
    padding:1.5rem 1.75rem;
  }
  .key-takeaways-title{
    color:var(--govblue);
    font-size:1.1rem;
    font-weight:700;
  }
  .key-takeaways-box ul{ padding-left:1.1rem; }
  .key-takeaways-box li{ line-height:1.5; }

  /* Markdown produces bare HTML tags with no Bootstrap classes attached,
     so table/link/code/etc. need their own styling here to match the
     rest of the site (govgreen/govblack theme, same as Layout.astro). */
  .blog-article :global(h2) { font-size: 1.3rem; font-weight: 700; margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-article :global(h3) { font-size: 1.1rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .blog-article :global(p) { margin-bottom: 1rem; }
  .blog-article :global(ul), .blog-article :global(ol) { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-article :global(li) { margin-bottom: 0.35rem; }
  .blog-article :global(a) { color: var(--govblue); text-decoration: underline; }
  .blog-article :global(a:visited) { color: #4c2c92; }
  .blog-article :global(strong) { font-weight: 700; }

  .blog-article :global(blockquote) {
    border-left: 4px solid var(--govblue);
    background: var(--govgrey);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--govblack);
  }
  .blog-article :global(blockquote p:last-child) { margin-bottom: 0; }

  .blog-article :global(code) {
    background: var(--govgrey);
    border: 1px solid var(--govborder);
    padding: 0.1rem 0.35rem;
    font-size: 0.9em;
  }
  .blog-article :global(pre) {
    background: var(--govblack);
    color: #fff;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .blog-article :global(pre code) { background: none; border: none; padding: 0; color: inherit; }

  .blog-article :global(hr) { border: none; border-top: 1px solid var(--govborder); margin: 2rem 0; }

  .blog-article :global(img) { max-width: 100%; height: auto; }

  /* Tables: reproduce Bootstrap's .table .table-sm look for bare markdown tables */
  .blog-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .blog-article :global(th),
  .blog-article :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--govborder);
    text-align: left;
  }
  .blog-article :global(thead th) {
    border-bottom: 2px solid var(--govblack);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .blog-article :global(tbody tr:nth-child(even)) { background: var(--govgrey); }

  .post-footer{
    border-top: 1px solid var(--govborder);
    background: transparent;
  }
  .post-footer-label{
    font-size:0.75rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.04em;
    color:#505a5f;
    margin-right:0.25rem;
  }

  .tag-pill{
    display:inline-block;
    background:var(--govgrey);
    border:1px solid var(--govborder);
    color:var(--govblack) !important;
    font-size:0.75rem;
    padding:0.25rem 0.6rem;
    border-radius:999px !important;
  }
  .tag-pill:hover{ background:var(--govblack); color:#fff !important; }

  .post-category-pill a{
    display:inline-block;
    background:rgba(255,255,255,0.15);
    color:#fff !important;
    font-size:0.7rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.03em;
    padding:0.3rem 0.75rem;
    border-radius:999px !important;
    text-decoration:none;
  }
  .post-hero .post-category-pill a:hover{ background:rgba(255,255,255,0.28); }
  .author-avatar-sm{
    width:36px; height:36px; flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
    background:var(--govblack); color:#fff;
    border-radius:50% !important;
    font-size:0.85rem; font-weight:700;
  }

  .post-sidebar-box{
    background: rgba(0,112,60,0.05);
    border-radius:10px !important;
    padding:1.25rem 1.4rem;
  }
  .post-sidebar-label{
    font-size:0.72rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.05em;
    color:#505a5f;
    margin:0;
  }
  .post-toc{ counter-reset:toc; }
  .post-toc li a{ color:var(--govblack); text-decoration:none; line-height:1.4; }
  .post-toc li a:hover{ color:var(--govblue); text-decoration:underline; }

  @media (min-width: 992px){
    .post-toc-box{ position:sticky; top:1rem; }
  }

  @media (max-width: 991.98px){
    .post-hero{ height:auto; overflow:visible; }
    .post-hero-inner.has-thumb{ padding-right: 0; padding-bottom: 1rem; }
    .post-hero-thumb-wrap{
      position: static;
      width: 100%;
      height: 220px;
      margin-top: 1.5rem;
      border-radius: 10px !important;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('copyLinkBtn');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url') || '';
    try {
      await navigator.clipboard.writeText(url);
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = original; }, 1500);
    } catch {
      // clipboard API unavailable — silently ignore
    }
  });
</script>
