---
// Shared layout for every blog post. Handles the breadcrumb, title/meta,
// table of contents (built from ## headings), related-post suggestions,
// and share buttons — so a new post only needs a markdown file in
// src/content/blog/, nothing else.
import Layout from './Layout.astro';
import { withBase } from '../lib/url.js';
import { slugify, categoryOf, authorOf, formatDate as fmtDate } from '../lib/blog.js';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, publishDate, updatedDate, tags } = post.data;
const category = categoryOf(post);
const author = authorOf(post);

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const aShared = a.data.tags.filter((t) => tags.includes(t)).length;
    const bShared = b.data.tags.filter((t) => tags.includes(t)).length;
    if (aShared !== bShared) return bShared - aShared;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  })
  .slice(0, 2);

// Only top-level (##) headings go in the TOC to keep it short and scannable.
const toc = headings.filter((h) => h.depth === 2);

const pageUrl = new URL(withBase(`tax-guides/${post.slug}/`), Astro.site).toString();

const dateFmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
<Layout title={`${title} | hmrctax.co.uk`} description={description}>
  <main class="container py-4 pb-5">
    <p class="small text-muted mb-2"><a href={withBase(`tax-guides/`)}>Tax Guides</a> &gt; {title}</p>
    <h1>{title}</h1>
    <p class="lead" style="max-width:65ch;">{description}</p>
    <p class="small text-muted">
      Published {dateFmt(publishDate)}{updatedDate && <> &middot; Updated {dateFmt(updatedDate)}</>}
      {' '}&middot; By <a href={withBase(`author/${slugify(author)}/`)}>{author}</a>
      {' '}&middot; <a href={withBase(`tax-guides/category/${slugify(category)}/`)} class="text-capitalize">{category.replace(/-/g, ' ')}</a>
    </p>
    {tags.length > 0 && (
      <p class="d-flex flex-wrap gap-2 mb-3">
        {tags.map((t) => (
          <a href={withBase(`tax-guides/tag/${slugify(t)}/`)} class="tag-pill text-capitalize text-decoration-none">{t.replace(/-/g, ' ')}</a>
        ))}
      </p>
    )}

    <div class="row g-4 mt-2">
      <div class="col-12 col-lg-8 order-2 order-lg-1">
        <article class="blog-article" style="max-width:65ch;">
          <slot />
        </article>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
          <span class="small fw-bold me-1">Share:</span>
          <a
            class="btn btn-sm btn-freq"
            target="_blank"
            rel="noopener"
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`}
          >X / Twitter</a>
          <a
            class="btn btn-sm btn-freq"
            target="_blank"
            rel="noopener"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`}
          >LinkedIn</a>
          <button type="button" class="btn btn-sm btn-freq" id="copyLinkBtn" data-url={pageUrl}>Copy link</button>
        </div>
      </div>

      <div class="col-12 col-lg-4 order-1 order-lg-2">
        <div class="stat-box mb-4">
          <h2 class="h6 fw-bold text-uppercase mb-2" style="letter-spacing:0.03em;">Written by</h2>
          <a href={withBase(`author/${slugify(author)}/`)} class="d-flex align-items-center gap-2 text-decoration-none">
            <span class="author-avatar-sm">{author.trim().charAt(0).toUpperCase()}</span>
            <span class="small fw-semibold" style="color:var(--govblack);">{author}</span>
          </a>
        </div>

        {toc.length > 0 && (
          <nav class="stat-box mb-4" aria-label="Table of contents">
            <h2 class="h6 fw-bold text-uppercase mb-2" style="letter-spacing:0.03em;">On this page</h2>
            <ul class="list-unstyled small mb-0">
              {toc.map((h) => (
                <li class="mb-1"><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}

        {related.length > 0 && (
          <div class="stat-box">
            <h2 class="h6 fw-bold text-uppercase mb-2" style="letter-spacing:0.03em;">Related articles</h2>
            <ul class="list-unstyled small mb-0">
              {related.map((p) => (
                <li class="mb-2"><a href={withBase(`tax-guides/${p.slug}/`)}>{p.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Markdown produces bare HTML tags with no Bootstrap classes attached,
     so table/link/code/etc. need their own styling here to match the
     rest of the site (govgreen/govblack theme, same as Layout.astro). */
  .blog-article :global(h2) { font-size: 1.3rem; font-weight: 700; margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-article :global(h3) { font-size: 1.1rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .blog-article :global(p) { margin-bottom: 1rem; }
  .blog-article :global(ul), .blog-article :global(ol) { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-article :global(li) { margin-bottom: 0.35rem; }
  .blog-article :global(a) { color: var(--govblue); text-decoration: underline; }
  .blog-article :global(a:visited) { color: #4c2c92; }
  .blog-article :global(strong) { font-weight: 700; }

  .blog-article :global(blockquote) {
    border-left: 4px solid var(--govblue);
    background: var(--govgrey);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--govblack);
  }
  .blog-article :global(blockquote p:last-child) { margin-bottom: 0; }

  .blog-article :global(code) {
    background: var(--govgrey);
    border: 1px solid var(--govborder);
    padding: 0.1rem 0.35rem;
    font-size: 0.9em;
  }
  .blog-article :global(pre) {
    background: var(--govblack);
    color: #fff;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .blog-article :global(pre code) { background: none; border: none; padding: 0; color: inherit; }

  .blog-article :global(hr) { border: none; border-top: 1px solid var(--govborder); margin: 2rem 0; }

  .blog-article :global(img) { max-width: 100%; height: auto; }

  /* Tables: reproduce Bootstrap's .table .table-sm look for bare markdown tables */
  .blog-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .blog-article :global(th),
  .blog-article :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--govborder);
    text-align: left;
  }
  .blog-article :global(thead th) {
    border-bottom: 2px solid var(--govblack);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .blog-article :global(tbody tr:nth-child(even)) { background: var(--govgrey); }

  .tag-pill{
    display:inline-block;
    background:var(--govgrey);
    border:1px solid var(--govborder);
    color:var(--govblack) !important;
    font-size:0.75rem;
    padding:0.25rem 0.6rem;
    border-radius:999px !important;
  }
  .tag-pill:hover{ background:var(--govblack); color:#fff !important; }
  .author-avatar-sm{
    width:36px; height:36px; flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
    background:var(--govblack); color:#fff;
    border-radius:50% !important;
    font-size:0.85rem; font-weight:700;
  }
</style>

<script>
  const btn = document.getElementById('copyLinkBtn');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url') || '';
    try {
      await navigator.clipboard.writeText(url);
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = original; }, 1500);
    } catch {
      // clipboard API unavailable — silently ignore
    }
  });
</script>
