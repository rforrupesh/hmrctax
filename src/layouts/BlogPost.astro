---
// Shared layout for every blog post. Handles the breadcrumb, title/meta,
// table of contents (built from ## headings), related-post suggestions,
// and share buttons — so a new post only needs a markdown file in
// src/content/blog/, nothing else.
import Layout from './Layout.astro';
import { withBase } from '../lib/url.js';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, publishDate, updatedDate, tags } = post.data;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const aShared = a.data.tags.filter((t) => tags.includes(t)).length;
    const bShared = b.data.tags.filter((t) => tags.includes(t)).length;
    if (aShared !== bShared) return bShared - aShared;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  })
  .slice(0, 2);

// Only top-level (##) headings go in the TOC to keep it short and scannable.
const toc = headings.filter((h) => h.depth === 2);

const pageUrl = new URL(withBase(`blog/${post.slug}/`), Astro.site).toString();

const dateFmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
<Layout title={`${title} | hmrctax.co.uk`} description={description}>
  <main class="container py-4 pb-5">
    <p class="small text-muted mb-2"><a href={withBase(`blog/`)}>Blog</a> &gt; {title}</p>
    <h1>{title}</h1>
    <p class="lead" style="max-width:65ch;">{description}</p>
    <p class="small text-muted">
      Published {dateFmt(publishDate)}{updatedDate && <> &middot; Updated {dateFmt(updatedDate)}</>}
    </p>

    <div class="row g-4 mt-2">
      <div class="col-12 col-lg-8 order-2 order-lg-1">
        <article class="blog-article" style="max-width:65ch;">
          <slot />
        </article>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
          <span class="small fw-bold me-1">Share:</span>
          <a
            class="btn btn-sm btn-freq"
            target="_blank"
            rel="noopener"
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`}
          >X / Twitter</a>
          <a
            class="btn btn-sm btn-freq"
            target="_blank"
            rel="noopener"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`}
          >LinkedIn</a>
          <button type="button" class="btn btn-sm btn-freq" id="copyLinkBtn" data-url={pageUrl}>Copy link</button>
        </div>
      </div>

      <div class="col-12 col-lg-4 order-1 order-lg-2">
        {toc.length > 0 && (
          <nav class="stat-box mb-4" aria-label="Table of contents">
            <h2 class="h6 fw-bold text-uppercase mb-2" style="letter-spacing:0.03em;">On this page</h2>
            <ul class="list-unstyled small mb-0">
              {toc.map((h) => (
                <li class="mb-1"><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}

        {related.length > 0 && (
          <div class="stat-box">
            <h2 class="h6 fw-bold text-uppercase mb-2" style="letter-spacing:0.03em;">Related articles</h2>
            <ul class="list-unstyled small mb-0">
              {related.map((p) => (
                <li class="mb-2"><a href={withBase(`blog/${p.slug}/`)}>{p.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>

<style>
  .blog-article :global(h2) { font-size: 1.3rem; font-weight: 700; margin-top: 2rem; }
  .blog-article :global(p) { margin-bottom: 1rem; }
  .blog-article :global(ul), .blog-article :global(ol) { margin-bottom: 1rem; }
</style>

<script>
  const btn = document.getElementById('copyLinkBtn');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url') || '';
    try {
      await navigator.clipboard.writeText(url);
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = original; }, 1500);
    } catch {
      // clipboard API unavailable — silently ignore
    }
  });
</script>
