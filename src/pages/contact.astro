---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Us — TaxCalc UK">
  <h1>Contact Us</h1>
  <p>Spotted an error in a calculation, or have a suggestion? Send us a message below.</p>

  <form class="mt-4" style="max-width: 500px;" action="#" method="post">
    <div class="mb-3">
      <label class="form-label" for="name">Name</label>
      <input type="text" class="form-control" id="name" name="name" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="email">Email</label>
      <input type="email" class="form-control" id="email" name="email" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="message">Message</label>
      <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Send Message</button>
  </form>
  <p class="text-muted small mt-3">Or email us directly at <a href="mailto:hello@your-domain.com">hello@your-domain.com</a></p>
</BaseLayout>
