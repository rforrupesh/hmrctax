---
// Redirects any old /blog/{slug}/ URL (from before the /tax-guides/ rename)
// to its new home, so old links and any indexed Google results still work.
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const target = withBase(`tax-guides/${slug}/`);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Redirecting…</title>
<link rel="canonical" href={new URL(target, Astro.site)} />
<meta http-equiv="refresh" content={`0; url=${target}`} />
</head>
<body>
<p>This page has moved to <a href={target}>this Tax Guide</a>.</p>
</body>
</html>
