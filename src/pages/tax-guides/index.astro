---
import Layout from '../../layouts/Layout.astro';
import PostGrid from '../../components/PostGrid.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<Layout title="UK Tax Guides | hmrctax.co.uk" description="UK tax guides and explainers — tax codes, National Insurance, and yearly rate changes.">
  <main class="container blog-index py-5 pb-5" style="max-width:1140px;">
    <h1 class="blog-index-heading">Tax Guides</h1>
    <PostGrid posts={posts} />
  </main>
</Layout>

<style>
  .blog-index-heading{ font-family: Georgia, "Times New Roman", serif; font-size:2.4rem; margin-bottom:0.5rem; }
</style>
