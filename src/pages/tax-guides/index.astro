---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url.js';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const initials = (title) => title.trim().charAt(0).toUpperCase();
---
<Layout title="UK Tax Guides | hmrctax.co.uk" description="UK tax guides and explainers — tax codes, National Insurance, and yearly rate changes.">
  <main class="container py-5 pb-5" style="max-width:1140px;">
    <h1>Tax Guides</h1>
    <p class="lead mb-4" style="max-width:60ch;">Plain-English guides to UK Income Tax and National Insurance.</p>

    <div class="row g-4">
      {posts.map((p) => (
        <div class="col-12 col-md-6 col-lg-4">
          <a href={withBase(`tax-guides/${p.slug}/`)} class="blog-card h-100 d-flex flex-column text-decoration-none">
            <div class="blog-card-thumb d-flex align-items-center justify-content-center">
              <span>{initials(p.data.title)}</span>
            </div>
            <div class="blog-card-body flex-grow-1 d-flex flex-column">
              <p class="blog-card-meta small mb-2">
                {dateFmt(p.data.publishDate)}
                {p.data.tags && p.data.tags[0] && <> &middot; <span class="text-capitalize">{p.data.tags[0].replace(/-/g, ' ')}</span></>}
              </p>
              <h2 class="blog-card-title h5 fw-bold mb-2">{p.data.title}</h2>
              <p class="blog-card-excerpt small text-muted mb-0">{p.data.description}</p>
              <div class="blog-card-author d-flex align-items-center gap-2 mt-3 pt-3">
                <span class="blog-card-avatar">HT</span>
                <span class="small">
                  <span class="d-block fw-semibold" style="color:var(--govblack);">hmrctax team</span>
                  <span class="d-block text-muted" style="font-size:0.75rem;">Writer</span>
                </span>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .blog-card{
    border:2px solid var(--govblack);
    background:#fff;
    overflow:hidden;
    transition: box-shadow .15s ease, transform .15s ease;
  }
  .blog-card:hover{
    box-shadow: 4px 4px 0 var(--govblack);
    transform: translate(-2px,-2px);
  }
  .blog-card-thumb{
    height:160px;
    background: linear-gradient(135deg, var(--govgreen), var(--govblue));
  }
  .blog-card-thumb span{
    font-size:2.5rem;
    font-weight:700;
    color:#fff;
    font-family: Georgia, serif;
  }
  .blog-card-body{ padding:1.25rem 1.25rem 1.5rem; }
  .blog-card-meta{ color:#505a5f; text-transform:uppercase; letter-spacing:0.02em; font-size:0.75rem; }
  .blog-card-title{ color:var(--govblack); line-height:1.3; }
  .blog-card-excerpt{
    display:-webkit-box;
    -webkit-line-clamp:3;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
  .blog-card-author{ border-top:1px solid var(--govborder); margin-top:auto; }
  .blog-card-avatar{
    width:32px; height:32px; flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
    background:var(--govblack); color:#fff;
    font-size:0.7rem; font-weight:700;
  }
</style>
