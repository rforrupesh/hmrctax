---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url.js';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const initials = (title) => title.trim().charAt(0).toUpperCase();
const palettes = [
  ['#00703c', '#1d70b8'],
  ['#1d70b8', '#0b0c0c'],
  ['#0b0c0c', '#00703c'],
];
---
<Layout title="UK Tax Guides | hmrctax.co.uk" description="UK tax guides and explainers — tax codes, National Insurance, and yearly rate changes.">
  <main class="container blog-index py-5 pb-5" style="max-width:1140px;">
    <h1 class="blog-index-heading">Tax Guides</h1>

    <div class="row g-4 g-lg-5 mt-2">
      {posts.map((p, i) => {
        const [c1, c2] = palettes[i % palettes.length];
        return (
        <div class="col-12 col-md-6 col-lg-4">
          <a href={withBase(`tax-guides/${p.slug}/`)} class="blog-card d-block text-decoration-none h-100">
            <div class="blog-card-thumb d-flex align-items-center justify-content-center" style={`background:linear-gradient(135deg, ${c1}, ${c2});`}>
              <span>{initials(p.data.title)}</span>
            </div>
            <p class="blog-card-meta small mb-2">
              {dateFmt(p.data.publishDate)}
              {p.data.tags && p.data.tags[0] && <> &middot; <span class="text-capitalize">{p.data.tags[0].replace(/-/g, ' ')}</span></>}
            </p>
            <h2 class="blog-card-title mb-2">{p.data.title}</h2>
            <p class="blog-card-excerpt small mb-0">{p.data.description}</p>
            <div class="blog-card-author d-flex align-items-center gap-2 mt-4">
              <span class="blog-card-avatar">HT</span>
              <span class="small">
                <span class="d-block fw-semibold" style="color:var(--govblack);">hmrctax team</span>
                <span class="d-block" style="font-size:0.75rem; color:#505a5f;">Writer</span>
              </span>
            </div>
          </a>
        </div>
      )})}
    </div>
  </main>
</Layout>

<style>
  .blog-index-heading{ font-family: Georgia, "Times New Roman", serif; font-size:2.4rem; margin-bottom:2rem; }
  .blog-card{ color:inherit; }
  .blog-card-thumb{
    height:190px;
    width:100%;
    border-radius:14px !important;
    overflow:hidden;
    margin-bottom:1.1rem;
  }
  .blog-card-thumb span{
    font-size:2.75rem;
    font-weight:700;
    color:#fff;
    font-family: Georgia, serif;
  }
  .blog-card-meta{ color:#505a5f; font-size:0.8rem; margin-top:0; }
  .blog-card-title{
    font-family: Georgia, "Times New Roman", serif;
    font-weight:700;
    font-size:1.15rem;
    line-height:1.35;
    color:var(--govblack);
  }
  .blog-card:hover .blog-card-title{ color:var(--govblue); text-decoration:underline; }
  .blog-card-excerpt{
    color:#505a5f;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
  .blog-card-author{ border-top:1px solid var(--govborder); padding-top:1rem; }
  .blog-card-avatar{
    width:32px; height:32px; flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
    background:var(--govblack); color:#fff;
    border-radius:50% !important;
    font-size:0.7rem; font-weight:700;
  }
</style>
