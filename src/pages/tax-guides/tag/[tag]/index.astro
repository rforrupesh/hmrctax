---
import Layout from '../../../../layouts/Layout.astro';
import PostGrid from '../../../../components/PostGrid.astro';
import { withBase } from '../../../../lib/url.js';
import { slugify } from '../../../../lib/blog.js';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tagMap = new Map();

  for (const post of allPosts) {
    for (const tag of post.data.tags || []) {
      const slug = slugify(tag);
      if (!tagMap.has(slug)) tagMap.set(slug, { label: tag, posts: [] });
      tagMap.get(slug).posts.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, { label, posts }]) => ({
    params: { tag },
    props: {
      label,
      posts: posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { label, posts } = Astro.props;
const title = label.replace(/-/g, ' ');
---
<Layout title={`${title} guides | salary-calc.co.uk`} description={`UK tax guides tagged "${title}".`}>
  <main class="container blog-index py-5 pb-5" style="max-width:1140px;">
    <p class="small text-muted mb-2"><a href={withBase(`tax-guides/`)}>Tax Guides</a> &gt; Tag</p>
    <h1 class="blog-index-heading text-capitalize">{title}</h1>
    <p class="lead mb-4" style="max-width:60ch;">{posts.length} guide{posts.length === 1 ? '' : 's'} tagged "{title}".</p>
    <PostGrid posts={posts} />
  </main>
</Layout>

<style>
  .blog-index-heading{ font-size:2.4rem; margin-bottom:0.5rem; }
</style>
