---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url.js';
---
<Layout title="Page not found — salary-calc.co.uk" description="Sorry, we couldn't find that page. Try our Income Tax calculator, tax guides or FAQ instead.">
  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <h1>Page not found</h1>
        <p class="lead mb-4">Sorry, we couldn't find the page you were looking for. It may have been moved, renamed, or the link might be out of date.</p>

        <div class="zero-note mb-4">
          <p class="small mb-0">If you followed a link from another site and think it's broken, please <a href={withBase(`contact/`)}>let us know</a> so we can fix it.</p>
        </div>

        <h2 class="h5 fw-bold mb-3">Try one of these instead</h2>
        <ul class="list-unstyled">
          <li class="mb-2"><a href={withBase()}>Home — Income Tax calculator</a></li>
          <li class="mb-2"><a href={withBase(`tax-calculator/`)}>Browse take-home pay by salary</a></li>
          <li class="mb-2"><a href={withBase(`tax-guides/`)}>Tax guides</a></li>
          <li class="mb-2"><a href={withBase(`faq/`)}>Frequently Asked Questions</a></li>
          <li class="mb-2"><a href={withBase(`about/`)}>About us</a></li>
          <li class="mb-2"><a href={withBase(`contact/`)}>Contact us</a></li>
        </ul>
      </div>
    </div>
  </main>
</Layout>
