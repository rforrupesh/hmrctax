---
// Content lives in src/content/pages/privacy-policy.md — edit that file, not this one.
import { getEntry } from 'astro:content';
import StaticPage from '../../layouts/StaticPage.astro';

const entry = await getEntry('pages', 'privacy-policy');
const { Content, headings } = await entry.render();
const { title, description, heroLead, image, takeaways } = entry.data;
---
<StaticPage title={title} description={description} heroLead={heroLead} image={image} takeaways={takeaways} headings={headings}>
  <Content />
</StaticPage>
