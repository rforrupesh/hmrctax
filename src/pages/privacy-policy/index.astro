---
import StaticPage from '../../layouts/StaticPage.astro';
import { withBase } from '../../lib/url.js';
---
<StaticPage
  title="Privacy Policy"
  description="Privacy policy for salary-calc.co.uk."
  heroLead="How salary-calc.co.uk handles your data — in short, we don't collect the numbers you type in."
>
  <p>This calculator runs entirely in your browser. The salary figures you enter are not sent to, or stored on, our servers.</p>
  <p>We may use third-party services such as analytics and advertising providers, which can collect standard technical data (such as browser type and IP address) in line with their own privacy policies.</p>
  <p>If you have any questions about this policy, please <a href={withBase(`contact/`)}>contact us</a>.</p>
</StaticPage>
